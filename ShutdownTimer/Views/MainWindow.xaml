<Window x:Class="ShutdownTimer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ShutdownTimer.Converters"
        mc:Ignorable="d"
        Title="Таймер выключения" 
        Height="650" 
        Width="450"
        MinHeight="600"
        MinWidth="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanConverter"/>
        <converters:ProgressToAngleConverter x:Key="ProgressToAngleConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" 
            CornerRadius="16" 
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Power Icon -->
                    <Path Data="M12,2C12.55,2 13,2.45 13,3V9C13,9.55 12.55,10 12,10C11.45,10 11,9.55 11,9V3C11,2.45 11.45,2 12,2M12,22A7,7 0 0,1 5,15H7A5,5 0 0,0 12,20A5,5 0 0,0 17,15H19A7,7 0 0,1 12,22Z" 
                          Fill="{StaticResource PrimaryBrush}" 
                          Width="20" Height="20"
                          Stretch="Uniform"/>
                    <TextBlock Text="Таймер выключения" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Width="30" Height="30" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="MinimizeButtonClick"
                            Padding="0"/>
                    <Button Content="✕" Width="30" Height="30" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButtonClick"
                            Padding="0"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Subtitle -->
            <TextBlock Grid.Row="1" 
                       Text="Компьютер выключится по истечении времени" 
                       FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="20,8,20,0"
                       HorizontalAlignment="Center"/>

            <!-- Timer Display -->
            <Grid Grid.Row="2" Margin="0,20,0,20">
                <Grid.Width>280</Grid.Width>
                <Grid.Height>280</Grid.Height>
                
                <!-- Circular Progress -->
                <Viewbox Stretch="Uniform">
                    <Grid Width="280" Height="280">
                        <!-- Background circle -->
                        <Ellipse Stroke="{StaticResource SurfaceLightBrush}" 
                                 StrokeThickness="8"
                                 Width="260" Height="260"/>
                        
                        <!-- Progress arc -->
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                     Minimum="0" Maximum="1"
                                     Width="260" Height="260"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource PrimaryBrush}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border Background="Transparent"/>
                                        <Canvas>
                                            <Path x:Name="PART_Track" 
                                                  Stroke="{StaticResource SurfaceLightBrush}"
                                                  StrokeThickness="8"
                                                  Data="M 130,10 A 120,120 0 1,1 130,250 A 120,120 0 1,1 130,10 Z"
                                                  Fill="Transparent"
                                                  StrokeDashArray="754"
                                                  StrokeDashOffset="0"
                                                  StrokeLineJoin="Round"/>
                                            <Path x:Name="PART_Indicator" 
                                                  Stroke="{StaticResource PrimaryGradient}"
                                                  StrokeThickness="8"
                                                  Data="M 130,10 A 120,120 0 1,1 130,250 A 120,120 0 1,1 130,10 Z"
                                                  Fill="Transparent"
                                                  StrokeDashArray="754"
                                                  StrokeDashOffset="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProgressToAngleConverter}}"
                                                  StrokeLineJoin="Round"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="-90"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        
                        <!-- Center content -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RemainingTime, Converter={StaticResource TimeSpanConverter}}"
                                       FontSize="42"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       FontFamily="Consolas"/>
                            <TextBlock Text="ДО ВЫКЛЮЧЕНИЯ"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Preset Buttons -->
            <UniformGrid Grid.Row="3" Columns="4" Margin="20,0">
                <Button Content="15 мин" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Preset15MinClick"
                        Margin="4"
                        Height="40"/>
                <Button Content="30 мин" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Preset30MinClick"
                        Margin="4"
                        Height="40"/>
                <Button Content="1 час" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Preset1HourClick"
                        Margin="4"
                        Height="40"/>
                <Button Content="2 часа" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Preset2HourClick"
                        Margin="4"
                        Height="40"/>
            </UniformGrid>

            <!-- Action Panel -->
            <Border Grid.Row="4" 
                    Background="{StaticResource SurfaceColor}"
                    CornerRadius="12"
                    Margin="20,20,20,20"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Действие" 
                               FontSize="14"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,12"/>
                    
                    <!-- Action ComboBox -->
                    <ComboBox SelectedIndex="{Binding SelectedAction}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Margin="0,0,0,16">
                        <ComboBoxItem>⏻ Выключить компьютер</ComboBoxItem>
                        <ComboBoxItem>↻ Перезагрузить компьютер</ComboBoxItem>
                        <ComboBoxItem>⇥ Выйти из системы</ComboBoxItem>
                        <ComboBoxItem>☾ Спящий режим</ComboBoxItem>
                    </ComboBox>
                    
                    <!-- Warning Checkbox -->
                    <CheckBox Content="Предупредить за 5 минут"
                              IsChecked="{Binding WarningEnabled}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,0,0,16"/>
                    
                    <!-- Start/Stop Button -->
                    <Button x:Name="StartStopButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="50"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Click="StartStopButtonClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
